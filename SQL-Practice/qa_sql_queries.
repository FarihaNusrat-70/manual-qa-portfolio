-- View all users
SELECT * FROM users;

-- Users older than 25
SELECT * FROM users WHERE age > 25;

-- Sort users by age
SELECT * FROM users ORDER BY age DESC;

-- INNER JOIN example
SELECT u.name, o.product
FROM users u
INNER JOIN orders o
ON u.id = o.user_id;

-- Users without orders
SELECT u.name
FROM users u
LEFT JOIN orders o
ON u.id = o.user_id
WHERE o.id IS NULL;

-- Count orders per user
SELECT u.name, COUNT(o.id) AS total_orders
FROM users u
LEFT JOIN orders o
ON u.id = o.user_id
GROUP BY u.name;
